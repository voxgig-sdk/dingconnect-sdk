# Entity: country

main: kit: entity: country: {

  alias: field: {}

  fields: [
    {
      name: "error_code"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "item"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "result_code"
      req: false
      type: "`$INTEGER`"
    }
  ]

  name: "country"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
